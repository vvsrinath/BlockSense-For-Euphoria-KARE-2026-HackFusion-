# ─────────────────────────────────────────────────────────────
# BlockSense environment configuration
#
# Copy this file to `.env` and fill in the providers you need.
# NEVER commit a real `.env` file — it is git-ignored on purpose.
# Every value below is optional: the app ships with a mock transport
# so it runs with zero configuration.
# ─────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────
API_BASE_URL=http://localhost:8787
API_PORT=8787
NODE_ENV=development
LOG_LEVEL=info

# ── Ethereum ─────────────────────────────────────────────────
ETHEREUM_RPC_URL=
ETHERSCAN_API_KEY=

# ── BNB Chain ────────────────────────────────────────────────
BNB_RPC_URL=
BSCSCAN_API_KEY=

# ── TRON ─────────────────────────────────────────────────────
TRON_RPC_URL=
TRON_API_KEY=

# ── Solana ───────────────────────────────────────────────────
SOLANA_RPC_URL=

# ── Bitcoin ──────────────────────────────────────────────────
BITCOIN_RPC_URL=
MEMPOOL_API_KEY=

# ── Feature flags ────────────────────────────────────────────
# Set to "false" to force every adapter into mock mode.
USE_LIVE_DATA=false
