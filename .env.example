# ─────────────────────────────────────────────────────────────
# BlockSense environment configuration
#
# Copy this file to `.env` and fill in the providers you need.
# NEVER commit a real `.env` file — it is git-ignored on purpose.
#
# Nothing below is required. The app ships with generated demo data and runs
# with zero configuration; the RPC variables are only read once you opt in to
# live chains.
# ─────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────
API_BASE_URL=http://localhost:8787
API_PORT=8787
NODE_ENV=development
LOG_LEVEL=info

# ── Demo vs live data ────────────────────────────────────────
# VITE_DEMO_MODE  browser transport: "true" uses the in-app mock API
# DEMO_MODE       API adapters:      "true" generates data, no chain contacted
# USE_LIVE_DATA   fallback when DEMO_MODE is unset
#
# DEMO_MODE wins over USE_LIVE_DATA in both directions, so a stale value in
# either one is never silently ambiguous. With neither set the app stays on
# demo data, which is why a fresh checkout needs no provider at all.
VITE_DEMO_MODE=true
DEMO_MODE=true
USE_LIVE_DATA=false

# ── Ethereum ─────────────────────────────────────────────────
# Only read when USE_LIVE_DATA is true. Leaving these empty falls back to the
# public endpoints listed in apps/api/src/config/index.ts.
ETHEREUM_RPC_URL=
ETHERSCAN_API_KEY=

# ── BNB Chain ────────────────────────────────────────────────
BNB_RPC_URL=
BSCSCAN_API_KEY=

# ── TRON ─────────────────────────────────────────────────────
TRON_RPC_URL=
TRON_API_KEY=

# ── Solana ───────────────────────────────────────────────────
SOLANA_RPC_URL=

# ── Bitcoin ──────────────────────────────────────────────────
BITCOIN_RPC_URL=
MEMPOOL_API_KEY=
